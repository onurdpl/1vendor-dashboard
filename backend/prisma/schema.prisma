generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  VENDOR
  SUPPORT
  FINANCE
}

enum AllocationStatus {
  ACTIVE
  VENDOR_BLOCKED
  PENDING_REASSIGNMENT
  REASSIGNED
  FULFILLED
}

enum CancellationReason {
  OUT_OF_STOCK
  VENDOR_CANCELLED
  DAMAGED_INVENTORY
  FULFILLMENT_ISSUE
}

enum WebhookStatus {
  RECEIVED
  PROCESSING
  PROCESSED
  FAILED
}

enum PayoutStatus {
  PENDING
  APPROVED
  PAID
  HOLD
}

enum OperationalJobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  RETRY_SCHEDULED
  RETRYING
  DEAD_LETTER_READY
  PERMANENTLY_FAILED
}

enum OperationalJobType {
  WEBHOOK_PROCESSING
  RECONCILIATION
  REPLAY
  RECOVERY
  FULFILLMENT_SYNC
  REFUND_SYNC
  RETURN_SYNC
}

enum ShippingDeductionMode {
  DISABLED
  FIXED
  EXTERNAL_PROVIDER
}

enum SettlementStatus {
  PENDING
  ACCRUING
  PAYABLE
  PARTIALLY_REFUNDED
  HELD
  SETTLED
  DISPUTED
}

enum PayoutBatchStatus {
  DRAFT
  REVIEW
  APPROVED
  CANCELLED
  EXECUTION_PENDING
  PAID_PLACEHOLDER
}

enum ShippingCostSourceType {
  MANUAL
  IMPORTED
  EXTERNAL_PROVIDER
}

enum ShippingCostStatus {
  PENDING
  CONFIRMED
  DISPUTED
  IGNORED
}

enum ShippingProvider {
  HEPSIJET
  KARGO_ENTEGRATOR
  TRY_OTO
  KARGONOMI
  NAVLUNGO
  MNG
  YURTICI
  ARAS
}

enum ShipmentExecutionStatus {
  PENDING
  CREATED
  FAILED
  IN_TRANSIT
  DELIVERED
  RETURNED
  CANCELLED
}

enum OperationalSignalSeverity {
  INFO
  WARNING
  HIGH
  CRITICAL
}

enum OperationalSignalStatus {
  ACTIVE
  ACKNOWLEDGED
  RESOLVED
  IGNORED
}

enum OperationalSignalSourceArea {
  PAYOUT
  REFUND
  FULFILLMENT
  DIAGNOSTICS
  RECONCILIATION
  SHIPPING_COST
  SETTLEMENT
}

enum NotificationChannel {
  IN_APP
  EMAIL_PLACEHOLDER
  SLACK_PLACEHOLDER
}

enum NotificationStatus {
  PENDING
  DELIVERED
  READ
  DISMISSED
  SKIPPED
  FAILED
}

enum NotificationRecipientRole {
  ADMIN
  VENDOR
}

enum AutomationActionStatus {
  PENDING
  SUGGESTED
  EXECUTED
  SKIPPED
  FAILED
  CANCELLED
}

enum AutomationExecutionMode {
  MANUAL
  ASSISTED
  AUTO_SAFE
}

enum AutomationActionType {
  SUGGEST_REPLAY_WEBHOOK
  SUGGEST_RECONCILIATION
  SUGGEST_PAYOUT_BATCH_REVIEW
  SUGGEST_SHIPPING_COST_ATTACHMENT
  SUGGEST_STALE_FULFILLMENT_REVIEW
  SUGGEST_PAYOUT_REVIEW
  SUGGEST_NEGATIVE_PAYOUT_INVESTIGATION
  SUGGEST_DEAD_LETTER_INVESTIGATION
  AUTO_CREATE_RECONCILIATION_CANDIDATE
  AUTO_GENERATE_REMINDER_NOTIFICATION
  AUTO_PRIORITIZE_STALE_QUEUE_ITEM
}

enum InvoiceExecutionProvider {
  BIZIMHESAP
  PARASUT
  BIRFATURA
}

enum InvoiceExecutionStatus {
  PENDING
  CREATED
  FAILED
  CANCELLED
  UNKNOWN
}

model User {
  id           String                        @id @default(cuid())
  email        String                        @unique
  name         String
  role         UserRole
  status       String                        @default("active")
  passwordHash String
  createdAt    DateTime                      @default(now())
  updatedAt    DateTime                      @updatedAt
  vendorLinks  UserVendorAccess[]
  assignments  AllocationAssignmentHistory[] @relation("assignmentActor")
  supportTickets SupportTicket[]
  supportNotes   SupportTicketNote[]
  supportReplies SupportTicketReply[]
}

model Vendor {
  id                    String                        @id
  name                  String
  status                String                        @default("active")
  createdAt             DateTime                      @default(now())
  updatedAt             DateTime                      @updatedAt
  users                 UserVendorAccess[]
  originalAllocations   VendorAllocation[]            @relation("originalVendor")
  assignedAllocations   VendorAllocation[]            @relation("assignedVendor")
  financeEntries        FinanceLedgerEntry[]
  shippingCosts         ShipmentShippingCost[]
  shippingConfig        VendorShippingConfig?
  shippingWarehouses    VendorShippingWarehouse[]
  shipmentExecutions    ShipmentExecution[]
  financialProfile      VendorFinancialProfile?
  payoutBatches         PayoutBatch[]
  operationalSignals    OperationalSignal[]
  automationActions     AutomationAction[]
  notifications         NotificationIntent[]
  supportTickets        SupportTicket[]
  assignmentHistoryFrom AllocationAssignmentHistory[] @relation("assignmentFromVendor")
  assignmentHistoryTo   AllocationAssignmentHistory[] @relation("assignmentToVendor")
}

model SupportTicket {
  id              String   @id @default(cuid())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  createdByUserId String
  createdByRole   String
  vendorId        String
  subject         String
  message         String
  priority        String   @default("normal")
  status          String   @default("OPEN")
  category        String   @default("OTHER")
  assigneeUserId  String?
  assigneeName    String?
  vendorUnreadCount Int    @default(0)
  adminUnreadCount  Int    @default(0)
  lastReplyAt     DateTime?
  lastReplyByRole String?
  firstResponseDueAt DateTime?
  nextResponseDueAt  DateTime?
  escalatedAt        DateTime?
  escalationReason   String?
  contextType     String
  contextId       String?
  contextSnapshot Json?
  resolvedAt      DateTime?
  closedAt        DateTime?
  createdBy       User     @relation(fields: [createdByUserId], references: [id], onDelete: Cascade)
  vendor          Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  notes           SupportTicketNote[]
  replies         SupportTicketReply[]

  @@index([vendorId, status, createdAt])
  @@index([category, status])
  @@index([assigneeUserId])
  @@index([adminUnreadCount])
  @@index([vendorUnreadCount])
  @@index([firstResponseDueAt])
  @@index([nextResponseDueAt])
  @@index([escalatedAt])
  @@index([contextType, contextId])
  @@index([createdAt])
}

model SupportTicketNote {
  id              String        @id @default(cuid())
  supportTicketId String
  authorUserId    String
  authorName      String
  authorRole      String
  content         String
  createdAt       DateTime      @default(now())
  supportTicket   SupportTicket @relation(fields: [supportTicketId], references: [id], onDelete: Cascade)
  author          User          @relation(fields: [authorUserId], references: [id], onDelete: Cascade)

  @@index([supportTicketId, createdAt])
}

model SupportTicketReply {
  id              String        @id @default(cuid())
  supportTicketId String
  authorUserId    String
  authorName      String
  authorRole      String
  message         String
  createdAt       DateTime      @default(now())
  supportTicket   SupportTicket @relation(fields: [supportTicketId], references: [id], onDelete: Cascade)
  author          User          @relation(fields: [authorUserId], references: [id], onDelete: Cascade)

  @@index([supportTicketId, createdAt])
}

model VendorFinancialProfile {
  id                     String                @id @default(cuid())
  vendorId               String                @unique
  commissionPercent      Decimal               @default(10.00) @db.Decimal(5, 2)
  commissionVatPercent   Decimal               @default(0.00) @db.Decimal(5, 2)
  deductShippingEnabled  Boolean               @default(false)
  shippingMode           ShippingDeductionMode @default(DISABLED)
  fixedShippingFee       Decimal?              @db.Decimal(10, 2)
  active                 Boolean               @default(true)
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt
  vendor                 Vendor                @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([vendorId, active])
}

model UserVendorAccess {
  id        String   @id @default(cuid())
  userId    String
  vendorId  String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  vendor    Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@unique([userId, vendorId])
}

model VendorIntegrationClient {
  id               String                      @id @default(cuid())
  vendorIdentifier String
  providerName     String
  tokenHash        String                      @unique
  enabled          Boolean                     @default(true)
  scopes           String[]
  lastUsedAt       DateTime?
  revokedAt        DateTime?
  createdAt        DateTime                    @default(now())
  updatedAt        DateTime                    @updatedAt
  auditLogs        VendorIntegrationAuditLog[]

  @@index([vendorIdentifier])
  @@index([enabled, revokedAt])
}

model VendorIntegrationAuditLog {
  id               String                  @id @default(cuid())
  clientId         String
  vendorIdentifier String
  method           String
  path             String
  statusCode       Int
  requestId        String?
  createdAt        DateTime                @default(now())
  client           VendorIntegrationClient @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId, createdAt])
  @@index([vendorIdentifier, createdAt])
}

model ShopifyOrder {
  id                       String                 @id @default(cuid())
  sourceShopifyOrderId     String                 @unique
  sourceShopifyOrderNumber String
  shopifyCreatedAt         DateTime?
  currency                 String?
  financialStatus          String?
  paymentGatewayName       String?
  shippingAmount           Decimal?               @db.Decimal(10, 2)
  discountAmount           Decimal?               @db.Decimal(10, 2)
  orderNote                String?
  orderTags                String[]               @default([])
  customerName             String?
  customerEmail            String?
  customerPhone            String?
  billingFullName          String?
  billingCompany           String?
  billingPhone             String?
  billingCity              String?
  billingDistrict          String?
  billingAddress1          String?
  billingAddress2          String?
  billingPostcode          String?
  shippingCountry          String?
  shippingPostcode         String?
  shippingCity             String?
  shippingDistrict         String?
  shippingAddress          String?
  totalPrice               Decimal?               @db.Decimal(10, 2)
  createdAt                DateTime               @default(now())
  updatedAt                DateTime               @updatedAt
  lineItems                ShopifyOrderLineItem[]
  allocations              VendorAllocation[]
  webhookEvents            WebhookEvent[]
  refunds                  ShopifyRefund[]
}

model ShopifyOrderLineItem {
  id                  String                     @id @default(cuid())
  shopifyOrderId      String
  sourceLineItemId    String
  shopifyProductId    String?
  sourceVariantId     String?
  sku                 String?
  title               String?
  imageUrl            String?
  quantity            Int                        @default(1)
  unitPrice           Decimal?                   @db.Decimal(10, 2)
  unitPriceVatIncluded Decimal?                  @db.Decimal(10, 2)
  lineTotalVatIncluded Decimal?                  @db.Decimal(10, 2)
  vatRate             Decimal?                   @db.Decimal(5, 2)
  originalVendorId    String?
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt
  order               ShopifyOrder               @relation(fields: [shopifyOrderId], references: [id], onDelete: Cascade)
  allocationLineItems VendorAllocationLineItem[]
  refundLineItems     ShopifyRefundLineItem[]

  @@unique([shopifyOrderId, sourceLineItemId])
}

model VendorAllocation {
  id                       String                        @id @default(cuid())
  sourceShopifyOrderId     String
  sourceShopifyOrderNumber String
  originalVendorId         String
  assignedVendorId         String
  allocationStatus         AllocationStatus              @default(ACTIVE)
  cancellationReason       CancellationReason?
  reassignmentRequired     Boolean                       @default(false)
  fulfillmentStatus        String                        @default("Pending")
  shippingStatus           String                        @default("Awaiting Shipment")
  trackingNumber           String?
  carrier                  String?
  odooSaleOrderId          String?
  odooSaleOrderName        String?
  odooSaleOrderSyncedAt    DateTime?
  createdAt                DateTime                      @default(now())
  updatedAt                DateTime                      @updatedAt
  order                    ShopifyOrder                  @relation(fields: [sourceShopifyOrderId], references: [id], onDelete: Cascade)
  originalVendor           Vendor                        @relation("originalVendor", fields: [originalVendorId], references: [id])
  assignedVendor           Vendor                        @relation("assignedVendor", fields: [assignedVendorId], references: [id])
  lineItems                VendorAllocationLineItem[]
  assignmentHistory        AllocationAssignmentHistory[]
  fulfillment              Fulfillment?
  returnRecords            ReturnRecord[]
  refundRecords            RefundRecord[]
  financeEntries           FinanceLedgerEntry[]
  operationalJobs          OperationalJob[]
  shippingCosts            ShipmentShippingCost[]
  shipmentExecutions       ShipmentExecution[]
  operationalSignals       OperationalSignal[]
  automationActions        AutomationAction[]

  @@index([odooSaleOrderId])
}

model VendorAllocationLineItem {
  id                   String               @id @default(cuid())
  vendorAllocationId   String
  shopifyLineItemId    String
  quantity             Int                  @default(1)
  lineAmount           Decimal?             @db.Decimal(10, 2)
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  vendorAllocation     VendorAllocation     @relation(fields: [vendorAllocationId], references: [id], onDelete: Cascade)
  shopifyOrderLineItem ShopifyOrderLineItem @relation(fields: [shopifyLineItemId], references: [id], onDelete: Cascade)

  @@unique([vendorAllocationId, shopifyLineItemId])
}

model AllocationAssignmentHistory {
  id                 String           @id @default(cuid())
  vendorAllocationId String
  action             String
  fromVendorId       String?
  toVendorId         String
  reason             String?
  actorUserId        String?
  createdAt          DateTime         @default(now())
  vendorAllocation   VendorAllocation @relation(fields: [vendorAllocationId], references: [id], onDelete: Cascade)
  fromVendor         Vendor?          @relation("assignmentFromVendor", fields: [fromVendorId], references: [id])
  toVendor           Vendor           @relation("assignmentToVendor", fields: [toVendorId], references: [id])
  actorUser          User?            @relation("assignmentActor", fields: [actorUserId], references: [id])
}

model Fulfillment {
  id                        String           @id @default(cuid())
  vendorAllocationId        String           @unique
  fulfillmentStatus         String
  trackingNumber            String?
  carrier                   String?
  trackingUrl               String?
  notifyCustomer            Boolean          @default(true)
  shopifyFulfillmentId      String?
  shopifyFulfillmentOrderId String?
  fulfilledAt               DateTime?
  shipmentCreatedAt         DateTime?
  shipmentUpdatedAt         DateTime?
  syncStatus                String?
  errorMessage              String?
  createdAt                 DateTime         @default(now())
  updatedAt                 DateTime         @updatedAt
  vendorAllocation          VendorAllocation @relation(fields: [vendorAllocationId], references: [id], onDelete: Cascade)
}

model ReturnRecord {
  id                       String           @id @default(cuid())
  vendorAllocationId       String
  sourceShopifyOrderId     String
  sourceShopifyOrderNumber String
  sourceShopifyRefundId    String?
  sourceShopifyReturnId    String?
  sourceShopifyReturnGid   String?
  sourceShopifyLineItemId  String?
  returnLifecycleStatus    String?
  returnRequestSource      String?
  requestCreatedAt         DateTime?
  requestUpdatedAt         DateTime?
  status                   String
  reason                   String?
  returnReasonNote         String?
  returnProvider           String?
  returnProviderShipmentId String?
  returnLabel              String?
  returnReferenceId        String?
  navlungoReturnCreatedAt  DateTime?
  returnProviderSnapshot   Json?
  returnCarrierName        String?
  returnTrackingNumber     String?
  returnTrackingUrl        String?
  vendorReceivedAt         DateTime?
  vendorReviewedAt         DateTime?
  vendorDecision           String?
  vendorDecisionReason     String?
  createdAt                DateTime         @default(now())
  updatedAt                DateTime         @updatedAt
  vendorAllocation         VendorAllocation @relation(fields: [vendorAllocationId], references: [id], onDelete: Cascade)
  operationalJobs          OperationalJob[]

  @@index([sourceShopifyReturnGid])
  @@index([sourceShopifyReturnId])
}

model RefundRecord {
  id                       String                  @id @default(cuid())
  vendorAllocationId       String
  sourceShopifyOrderId     String
  sourceShopifyOrderNumber String
  sourceShopifyRefundId    String
  amount                   Decimal?                @db.Decimal(10, 2)
  status                   String
  createdAt                DateTime                @default(now())
  updatedAt                DateTime                @updatedAt
  vendorAllocation         VendorAllocation        @relation(fields: [vendorAllocationId], references: [id], onDelete: Cascade)
  lineItems                ShopifyRefundLineItem[]
  operationalJobs          OperationalJob[]
}

model ShopifyRefund {
  id                       String                  @id @default(cuid())
  shopifyOrderId           String
  sourceShopifyOrderId     String
  sourceShopifyOrderNumber String
  sourceShopifyRefundId    String                  @unique
  createdAt                DateTime                @default(now())
  updatedAt                DateTime                @updatedAt
  order                    ShopifyOrder            @relation(fields: [shopifyOrderId], references: [id], onDelete: Cascade)
  lineItems                ShopifyRefundLineItem[]
}

model ShopifyRefundLineItem {
  id                     String               @id @default(cuid())
  shopifyRefundId        String
  refundRecordId         String?
  shopifyOrderLineItemId String
  sourceRefundLineItemId String
  sourceLineItemId       String
  sku                    String?
  title                  String?
  quantity               Int                  @default(1)
  subtotal               Decimal?             @db.Decimal(10, 2)
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt
  shopifyRefund          ShopifyRefund        @relation(fields: [shopifyRefundId], references: [id], onDelete: Cascade)
  refundRecord           RefundRecord?        @relation(fields: [refundRecordId], references: [id], onDelete: SetNull)
  shopifyOrderLineItem   ShopifyOrderLineItem @relation(fields: [shopifyOrderLineItemId], references: [id], onDelete: Cascade)

  @@unique([shopifyRefundId, sourceRefundLineItemId])
}

model FinanceLedgerEntry {
  id                            String                 @id @default(cuid())
  vendorAllocationId            String?
  vendorId                      String
  entryType                     String
  amount                        Decimal                @db.Decimal(10, 2)
  payoutStatus                  PayoutStatus           @default(PENDING)
  description                   String?
  commissionPercentSnapshot     Decimal?               @db.Decimal(5, 2)
  commissionVatPercentSnapshot  Decimal?               @db.Decimal(5, 2)
  deductShippingEnabledSnapshot Boolean?
  shippingModeSnapshot          ShippingDeductionMode?
  fixedShippingFeeSnapshot      Decimal?               @db.Decimal(10, 2)
  shippingCostSnapshot          Decimal?               @db.Decimal(10, 2)
  shippingVatAmountSnapshot     Decimal?               @db.Decimal(10, 2)
  shippingCostSourceSnapshot    String?
  shippingCostProviderSnapshot  String?
  shippingCostIdSnapshot        String?
  financialProfileIdSnapshot    String?
  settlementStatus              SettlementStatus       @default(PENDING)
  settlementEligibleAt          DateTime?
  accruedAt                     DateTime?
  payableAt                     DateTime?
  settledAt                     DateTime?
  settlementHoldReason          String?
  createdAt                     DateTime               @default(now())
  updatedAt                     DateTime               @updatedAt
  vendorAllocation              VendorAllocation?      @relation(fields: [vendorAllocationId], references: [id], onDelete: SetNull)
  vendor                        Vendor                 @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  payoutBatchLines              PayoutBatchLine[]
  invoiceExecutions             InvoiceExecution[]
  operationalSignals            OperationalSignal[]
  automationActions             AutomationAction[]

  @@index([vendorId, entryType])
  @@index([vendorId, settlementStatus])
}

model InvoiceExecution {
  id                   String                   @id @default(cuid())
  financeLedgerEntryId String
  provider             InvoiceExecutionProvider
  providerInvoiceGuid  String?
  providerInvoiceNo    String?
  providerPdfUrl       String?
  status               InvoiceExecutionStatus  @default(PENDING)
  requestSnapshot      Json
  responseSnapshot     Json?
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt
  financeLedgerEntry   FinanceLedgerEntry       @relation(fields: [financeLedgerEntryId], references: [id], onDelete: Cascade)

  @@unique([financeLedgerEntryId, provider])
  @@index([provider, status])
  @@index([createdAt])
}

model ShipmentShippingCost {
  id                         String                 @id
  vendorId                   String
  allocationId               String
  sourceShopifyOrderId       String
  sourceShopifyFulfillmentId String?
  providerName               String
  providerReference          String?
  shippingCost               Decimal                @db.Decimal(10, 2)
  shippingVatAmount          Decimal?               @db.Decimal(10, 2)
  currency                   String                 @default("TRY")
  status                     ShippingCostStatus     @default(PENDING)
  sourceType                 ShippingCostSourceType @default(MANUAL)
  createdAt                  DateTime               @default(now())
  updatedAt                  DateTime               @updatedAt
  vendor                     Vendor                 @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  allocation                 VendorAllocation       @relation(fields: [allocationId], references: [id], onDelete: Cascade)

  @@index([vendorId, status])
  @@index([allocationId, status])
  @@index([sourceShopifyOrderId])
}

model VendorShippingConfig {
  id                String           @id @default(cuid())
  vendorId          String           @unique
  preferredProvider ShippingProvider @default(HEPSIJET)
  shippingEnabled   Boolean          @default(true)
  defaultDesi       Decimal          @default(3.00) @db.Decimal(10, 2)
  cargoIntegrationId String?
  defaultWarehouseId String?
  shippingVatPercent Decimal          @default(18.00) @db.Decimal(5, 2)
  providerMetadata  Json?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  vendor            Vendor           @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  warehouses        VendorShippingWarehouse[]

  @@index([vendorId, shippingEnabled])
}

model VendorShippingWarehouse {
  id                String               @id @default(cuid())
  configId          String
  vendorId          String
  provider          ShippingProvider
  warehouseId       String
  name              String?
  address           String?
  isDefault         Boolean              @default(false)
  metadata          Json?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  config            VendorShippingConfig @relation(fields: [configId], references: [id], onDelete: Cascade)
  vendor            Vendor               @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@unique([vendorId, provider, warehouseId])
  @@index([configId, isDefault])
  @@index([vendorId, provider, isDefault])
}

model ShipmentExecution {
  id                         String                  @id
  allocationId               String
  vendorId                   String
  sourceShopifyOrderId       String?
  sourceShopifyOrderNumber   String?
  sourceShopifyFulfillmentId String?
  provider                   ShippingProvider
  providerShipmentId         String?
  trackingNumber             String?
  trackingUrl                String?
  labelUrl                   String?
  shipmentStatus             ShipmentExecutionStatus @default(PENDING)
  desi                       Decimal                 @default(3.00) @db.Decimal(10, 2)
  cargoIntegrationId         String?
  warehouseId                String?
  shippingCost               Decimal?                @db.Decimal(10, 2)
  shippingVat                Decimal?                @db.Decimal(10, 2)
  currency                   String                  @default("TRY")
  requestSnapshot            Json
  responseSnapshot           Json?
  createdAt                  DateTime                @default(now())
  updatedAt                  DateTime                @updatedAt
  allocation                 VendorAllocation        @relation(fields: [allocationId], references: [id], onDelete: Cascade)
  vendor                     Vendor                  @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@unique([allocationId, provider])
  @@index([sourceShopifyOrderId])
  @@index([vendorId, shipmentStatus])
  @@index([provider, shipmentStatus])
  @@index([createdAt])
}

model PayoutBatch {
  id                      String            @id @default(cuid())
  vendorId                String
  status                  PayoutBatchStatus @default(DRAFT)
  grossAmount             Decimal           @default(0.00) @db.Decimal(10, 2)
  commissionAmount        Decimal           @default(0.00) @db.Decimal(10, 2)
  commissionVatAmount     Decimal           @default(0.00) @db.Decimal(10, 2)
  shippingDeductionAmount Decimal           @default(0.00) @db.Decimal(10, 2)
  refundAmount            Decimal           @default(0.00) @db.Decimal(10, 2)
  netAmount               Decimal           @default(0.00) @db.Decimal(10, 2)
  currency                String            @default("TRY")
  createdByUserId         String?
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt
  vendor                  Vendor            @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  lines                   PayoutBatchLine[]
  operationalSignals      OperationalSignal[]
  automationActions       AutomationAction[]

  @@index([vendorId, status])
  @@index([createdAt])
}

model PayoutBatchLine {
  id                   String             @id @default(cuid())
  payoutBatchId        String
  financeLedgerEntryId String
  amountSnapshot       Decimal            @db.Decimal(10, 2)
  createdAt            DateTime           @default(now())
  payoutBatch          PayoutBatch        @relation(fields: [payoutBatchId], references: [id], onDelete: Cascade)
  financeLedgerEntry   FinanceLedgerEntry @relation(fields: [financeLedgerEntryId], references: [id], onDelete: Cascade)

  @@unique([payoutBatchId, financeLedgerEntryId])
  @@index([financeLedgerEntryId])
}

model WebhookEvent {
  id               String           @id @default(cuid())
  sourceShopDomain String
  topic            String
  webhookId        String?
  idempotencyKey   String?          @unique
  payloadHash      String?
  rawPayload       String?
  status           WebhookStatus    @default(RECEIVED)
  receivedAt       DateTime         @default(now())
  processedAt      DateTime?
  errorMessage     String?
  shopifyOrderId   String?
  shopifyOrder     ShopifyOrder?    @relation(fields: [shopifyOrderId], references: [id], onDelete: SetNull)
  operationalJobs  OperationalJob[]

  @@unique([sourceShopDomain, topic, webhookId])
}

model OperationalJob {
  id                   String               @id @default(cuid())
  jobType              OperationalJobType
  status               OperationalJobStatus @default(PENDING)
  priority             Int                  @default(0)
  payload              Json?
  payloadRef           String?
  webhookEventId       String?
  sourceShopifyOrderId String?
  vendorAllocationId   String?
  refundRecordId       String?
  returnRecordId       String?
  retryCount           Int                  @default(0)
  maxRetries           Int                  @default(3)
  scheduledAt          DateTime             @default(now())
  nextRetryAt          DateTime?
  lastAttemptAt        DateTime?
  retryBackoffMs       Int?
  startedAt            DateTime?
  completedAt          DateTime?
  failedAt             DateTime?
  errorSummary         String?
  failureCategory      String?
  escalationReason     String?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  webhookEvent         WebhookEvent?        @relation(fields: [webhookEventId], references: [id], onDelete: SetNull)
  vendorAllocation     VendorAllocation?    @relation(fields: [vendorAllocationId], references: [id], onDelete: SetNull)
  refundRecord         RefundRecord?        @relation(fields: [refundRecordId], references: [id], onDelete: SetNull)
  returnRecord         ReturnRecord?        @relation(fields: [returnRecordId], references: [id], onDelete: SetNull)
  operationalSignals   OperationalSignal[]
  automationActions    AutomationAction[]

  @@index([status, scheduledAt])
  @@index([status, nextRetryAt])
  @@index([jobType])
  @@index([webhookEventId])
  @@index([vendorAllocationId])
  @@index([sourceShopifyOrderId])
}

model OperationalSignal {
  id                   String                      @id
  type                 String
  severity             OperationalSignalSeverity
  sourceArea           OperationalSignalSourceArea
  vendorId             String?
  allocationId         String?
  financeLedgerEntryId String?
  payoutBatchId        String?
  operationalJobId     String?
  title                String
  description          String
  suggestedAction      String?
  status               OperationalSignalStatus     @default(ACTIVE)
  ruleKey              String
  triggeredAt          DateTime                    @default(now())
  resolvedAt           DateTime?
  metadata             Json?
  createdAt            DateTime                    @default(now())
  updatedAt            DateTime                    @updatedAt
  vendor               Vendor?                     @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  allocation           VendorAllocation?           @relation(fields: [allocationId], references: [id], onDelete: SetNull)
  financeLedgerEntry   FinanceLedgerEntry?         @relation(fields: [financeLedgerEntryId], references: [id], onDelete: SetNull)
  payoutBatch          PayoutBatch?                @relation(fields: [payoutBatchId], references: [id], onDelete: SetNull)
  operationalJob       OperationalJob?             @relation(fields: [operationalJobId], references: [id], onDelete: SetNull)
  notifications        NotificationIntent[]
  automationActions    AutomationAction[]

  @@index([status, severity])
  @@index([vendorId, status])
  @@index([sourceArea, status])
  @@index([ruleKey])
  @@index([triggeredAt])
}

model NotificationIntent {
  id            String                    @id
  signalId      String?
  vendorId      String?
  recipientRole NotificationRecipientRole
  channel       NotificationChannel       @default(IN_APP)
  status        NotificationStatus        @default(PENDING)
  title         String
  message       String
  severity      OperationalSignalSeverity
  deliveredAt   DateTime?
  readAt        DateTime?
  metadata      Json?
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt
  signal        OperationalSignal?        @relation(fields: [signalId], references: [id], onDelete: SetNull)
  vendor        Vendor?                   @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([recipientRole, status])
  @@index([vendorId, status])
  @@index([signalId])
  @@index([createdAt])
}

model AutomationAction {
  id                   String                  @id
  signalId             String?
  type                 AutomationActionType
  status               AutomationActionStatus  @default(SUGGESTED)
  executionMode        AutomationExecutionMode @default(MANUAL)
  vendorId             String?
  allocationId         String?
  financeLedgerEntryId String?
  payoutBatchId        String?
  operationalJobId     String?
  title                String
  description          String
  resultSummary        String?
  executedAt           DateTime?
  metadata             Json?
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt
  signal               OperationalSignal?      @relation(fields: [signalId], references: [id], onDelete: SetNull)
  vendor               Vendor?                 @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  allocation           VendorAllocation?       @relation(fields: [allocationId], references: [id], onDelete: SetNull)
  financeLedgerEntry   FinanceLedgerEntry?     @relation(fields: [financeLedgerEntryId], references: [id], onDelete: SetNull)
  payoutBatch          PayoutBatch?            @relation(fields: [payoutBatchId], references: [id], onDelete: SetNull)
  operationalJob       OperationalJob?         @relation(fields: [operationalJobId], references: [id], onDelete: SetNull)

  @@index([status, type])
  @@index([vendorId, status])
  @@index([signalId])
  @@index([createdAt])
}
