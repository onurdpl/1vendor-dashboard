generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  VENDOR
  SUPPORT
  FINANCE
}

enum AllocationStatus {
  ACTIVE
  VENDOR_BLOCKED
  PENDING_REASSIGNMENT
  REASSIGNED
  FULFILLED
}

enum CancellationReason {
  OUT_OF_STOCK
  VENDOR_CANCELLED
  DAMAGED_INVENTORY
  FULFILLMENT_ISSUE
}

enum WebhookStatus {
  RECEIVED
  PROCESSING
  PROCESSED
  FAILED
}

enum PayoutStatus {
  PENDING
  APPROVED
  PAID
  HOLD
}

enum OperationalJobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  RETRY_SCHEDULED
  RETRYING
  DEAD_LETTER_READY
  PERMANENTLY_FAILED
}

enum OperationalJobType {
  WEBHOOK_PROCESSING
  RECONCILIATION
  REPLAY
  RECOVERY
  FULFILLMENT_SYNC
  REFUND_SYNC
  RETURN_SYNC
}

enum ShippingDeductionMode {
  DISABLED
  FIXED
  EXTERNAL_PROVIDER
}

enum SettlementFrequencyType {
  WEEKLY
  BIWEEKLY
}

enum SettlementWeekday {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
}

enum SettlementScheduleJobRunStatus {
  PROCESSING
  DRY_RUN
  COMPLETED
  BLOCKED
  FAILED
}

enum SettlementStatus {
  PENDING
  ACCRUING
  PAYABLE
  PARTIALLY_REFUNDED
  HELD
  SETTLED
  DISPUTED
}

enum SettlementApprovalStatus {
  DRAFT
  APPROVED
  CANCELLED
}

enum SettlementApprovalLineType {
  SALE
  REFUND
  REFUND_ADJUSTMENT
}

enum SettlementCommissionInvoiceProvider {
  LOGO_ISBASI
}

enum SettlementCommissionInvoiceStatus {
  PENDING
  CREATED
  FAILED
  CANCELLED
  UNKNOWN
}

enum SettlementRefundAdjustmentStatus {
  PENDING
  PARTIALLY_APPLIED
  APPLIED
  BLOCKED
  CANCELLED
}

enum SettlementRefundAdjustmentApplicationStatus {
  ACTIVE
  CANCELLED
}

enum SettlementRefundAdjustmentEventType {
  CREATED
  PARTIALLY_APPLIED
  APPLIED
  APPLICATION_CANCELLED
  ADJUSTMENT_CANCELLED
}

enum PayoutBatchStatus {
  DRAFT
  REVIEW
  APPROVED
  CANCELLED
  EXECUTION_PENDING
  PAID_PLACEHOLDER
}

enum VendorBalanceEventType {
  PAYABLE_EARNED
  VENDOR_DEBT_CREATED
  VENDOR_DEBT_OFFSET
  MANUAL_ADJUSTMENT
  DEBT_WAIVED
}

enum FinanceEventType {
  SALE_RECORDED
  COMMISSION_RESERVED
  COMMISSION_VAT_RESERVED
  VENDOR_PAYABLE_RESERVED
  REFUND_RECORDED
  COMMISSION_REVERSED
  COMMISSION_VAT_REVERSED
  VENDOR_PAYABLE_REVERSED
  MANUAL_ADJUSTMENT
}

enum ShippingCostSourceType {
  MANUAL
  IMPORTED
  EXTERNAL_PROVIDER
}

enum ShippingCostStatus {
  PENDING
  CONFIRMED
  DISPUTED
  IGNORED
}

enum ShippingProvider {
  HEPSIJET
  KARGO_ENTEGRATOR
  TRY_OTO
  KARGONOMI
  NAVLUNGO
  MNG
  YURTICI
  ARAS
}

enum ShipmentExecutionStatus {
  PENDING
  CREATED
  FAILED
  IN_TRANSIT
  DELIVERED
  RETURNED
  CANCELLED
}

enum OperationalSignalSeverity {
  INFO
  WARNING
  HIGH
  CRITICAL
}

enum OperationalSignalStatus {
  ACTIVE
  ACKNOWLEDGED
  RESOLVED
  IGNORED
}

enum OperationalSignalSourceArea {
  PAYOUT
  REFUND
  FULFILLMENT
  DIAGNOSTICS
  RECONCILIATION
  SHIPPING_COST
  SETTLEMENT
}

enum NotificationChannel {
  IN_APP
  EMAIL_PLACEHOLDER
  SLACK_PLACEHOLDER
}

enum NotificationStatus {
  PENDING
  DELIVERED
  READ
  DISMISSED
  SKIPPED
  FAILED
}

enum NotificationRecipientRole {
  ADMIN
  VENDOR
}

enum AutomationActionStatus {
  PENDING
  SUGGESTED
  EXECUTED
  SKIPPED
  FAILED
  CANCELLED
}

enum AutomationExecutionMode {
  MANUAL
  ASSISTED
  AUTO_SAFE
}

enum AutomationActionType {
  SUGGEST_REPLAY_WEBHOOK
  SUGGEST_RECONCILIATION
  SUGGEST_PAYOUT_BATCH_REVIEW
  SUGGEST_SHIPPING_COST_ATTACHMENT
  SUGGEST_STALE_FULFILLMENT_REVIEW
  SUGGEST_PAYOUT_REVIEW
  SUGGEST_NEGATIVE_PAYOUT_INVESTIGATION
  SUGGEST_DEAD_LETTER_INVESTIGATION
  AUTO_CREATE_RECONCILIATION_CANDIDATE
  AUTO_GENERATE_REMINDER_NOTIFICATION
  AUTO_PRIORITIZE_STALE_QUEUE_ITEM
}

enum VendorProfileSnapshotImpact {
  FUTURE_LEDGER_ROWS_ONLY
  FUTURE_SETTLEMENT_APPROVALS_ONLY
  FUTURE_COMMISSION_INVOICES_ONLY
  FUTURE_SHIPMENTS_ONLY
  FUTURE_RETURNS_ONLY
  FUTURE_SHIPMENTS_AND_RETURNS_ONLY
  EXISTING_SETTLEMENTS_UNCHANGED
  PROVIDER_REBIND_REQUIRED
  FUTURE_PAYOUT_RELEVANT
  DIAGNOSTIC_ONLY
  UNKNOWN
}

model User {
  id                                 String                         @id @default(cuid())
  email                              String                         @unique
  name                               String
  role                               UserRole
  status                             String                         @default("active")
  passwordHash                       String
  createdAt                          DateTime                       @default(now())
  updatedAt                          DateTime                       @updatedAt
  vendorLinks                        UserVendorAccess[]
  assignments                        AllocationAssignmentHistory[]  @relation("assignmentActor")
  economicTransfersAdministered      AllocationEconomicTransfer[]   @relation("economicTransferAdminActor")
  financeIntegrityAlertsAcknowledged FinanceIntegrityAlert[]        @relation("financeIntegrityAlertAcknowledgedBy")
  financeIntegrityAlertsResolved     FinanceIntegrityAlert[]        @relation("financeIntegrityAlertResolvedBy")
  outboundRefundAttemptsRequested    OutboundShopifyRefundAttempt[] @relation("outboundShopifyRefundAttemptRequestedBy")
  supportTickets                     SupportTicket[]
  supportNotes                       SupportTicketNote[]
  supportReplies                     SupportTicketReply[]
}

model Vendor {
  id                           String                        @id
  name                         String
  status                       String                        @default("active")
  createdAt                    DateTime                      @default(now())
  updatedAt                    DateTime                      @updatedAt
  users                        UserVendorAccess[]
  originalAllocations          VendorAllocation[]            @relation("originalVendor")
  assignedAllocations          VendorAllocation[]            @relation("assignedVendor")
  financeEntries               FinanceLedgerEntry[]
  shippingCosts                ShipmentShippingCost[]
  shippingConfig               VendorShippingConfig?
  shippingWarehouses           VendorShippingWarehouse[]
  shipmentExecutions           ShipmentExecution[]
  financialProfile             VendorFinancialProfile?
  billingProfile               VendorBillingProfile?
  financeEvents                FinanceEvent[]
  payoutBatches                PayoutBatch[]
  settlementApprovals          SettlementApproval[]
  settlementCommissionInvoices SettlementCommissionInvoice[]
  settlementRefundAdjustments  SettlementRefundAdjustment[]
  balanceEvents                VendorBalanceEvent[]
  profileAuditLogs             VendorProfileAuditLog[]
  operationalSignals           OperationalSignal[]
  automationActions            AutomationAction[]
  notifications                NotificationIntent[]
  supportTickets               SupportTicket[]
  assignmentHistoryFrom        AllocationAssignmentHistory[] @relation("assignmentFromVendor")
  assignmentHistoryTo          AllocationAssignmentHistory[] @relation("assignmentToVendor")
  economicTransfersFrom        AllocationEconomicTransfer[]  @relation("economicTransferFromVendor")
  economicTransfersTo          AllocationEconomicTransfer[]  @relation("economicTransferToVendor")
  ownedReturnRecords           ReturnRecord[]                @relation("returnOwnerVendor")
}

model SupportTicket {
  id                 String               @id @default(cuid())
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  createdByUserId    String
  createdByRole      String
  vendorId           String
  subject            String
  message            String
  priority           String               @default("normal")
  status             String               @default("OPEN")
  category           String               @default("OTHER")
  assigneeUserId     String?
  assigneeName       String?
  vendorUnreadCount  Int                  @default(0)
  adminUnreadCount   Int                  @default(0)
  lastReplyAt        DateTime?
  lastReplyByRole    String?
  firstResponseDueAt DateTime?
  nextResponseDueAt  DateTime?
  escalatedAt        DateTime?
  escalationReason   String?
  contextType        String
  contextId          String?
  contextSnapshot    Json?
  resolvedAt         DateTime?
  closedAt           DateTime?
  createdBy          User                 @relation(fields: [createdByUserId], references: [id], onDelete: Cascade)
  vendor             Vendor               @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  notes              SupportTicketNote[]
  replies            SupportTicketReply[]

  @@index([vendorId, status, createdAt])
  @@index([category, status])
  @@index([assigneeUserId])
  @@index([adminUnreadCount])
  @@index([vendorUnreadCount])
  @@index([firstResponseDueAt])
  @@index([nextResponseDueAt])
  @@index([escalatedAt])
  @@index([contextType, contextId])
  @@index([createdAt])
}

model SupportTicketNote {
  id              String        @id @default(cuid())
  supportTicketId String
  authorUserId    String
  authorName      String
  authorRole      String
  content         String
  createdAt       DateTime      @default(now())
  supportTicket   SupportTicket @relation(fields: [supportTicketId], references: [id], onDelete: Cascade)
  author          User          @relation(fields: [authorUserId], references: [id], onDelete: Cascade)

  @@index([supportTicketId, createdAt])
}

model SupportTicketReply {
  id              String        @id @default(cuid())
  supportTicketId String
  authorUserId    String
  authorName      String
  authorRole      String
  message         String
  createdAt       DateTime      @default(now())
  supportTicket   SupportTicket @relation(fields: [supportTicketId], references: [id], onDelete: Cascade)
  author          User          @relation(fields: [authorUserId], references: [id], onDelete: Cascade)

  @@index([supportTicketId, createdAt])
}

model VendorFinancialProfile {
  id                           String                  @id @default(cuid())
  vendorId                     String                  @unique
  commissionPercent            Decimal                 @default(10.00) @db.Decimal(5, 2)
  commissionVatPercent         Decimal                 @default(0.00) @db.Decimal(5, 2)
  deductShippingEnabled        Boolean                 @default(false)
  shippingMode                 ShippingDeductionMode   @default(DISABLED)
  fixedShippingFee             Decimal?                @db.Decimal(10, 2)
  settlementDelayDays          Int                     @default(21)
  settlementFrequencyType      SettlementFrequencyType @default(WEEKLY)
  weeklySettlementDay          SettlementWeekday       @default(WEDNESDAY)
  autoSettlementDraftEnabled   Boolean                 @default(false)
  autoSettlementApproveEnabled Boolean                 @default(false)
  autoSettlementInvoiceEnabled Boolean                 @default(false)
  active                       Boolean                 @default(true)
  createdAt                    DateTime                @default(now())
  updatedAt                    DateTime                @updatedAt
  vendor                       Vendor                  @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([vendorId, active])
}

model VendorBillingProfile {
  id                         String    @id @default(cuid())
  vendorId                   String    @unique
  legalCompanyName           String?
  taxNumber                  String?
  taxOffice                  String?
  billingAddress             String?
  billingCity                String?
  billingDistrict            String?
  iban                       String?
  authorizedPerson           String?
  billingEmail               String?
  billingPhone               String?
  legalEntityType            String?
  logoIsbasiCustomerCode     String?
  logoIsbasiCustomerId       String?
  logoIsbasiEinvoiceEligible Boolean?
  logoIsbasiLastCheckedAt    DateTime?
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt
  vendor                     Vendor    @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([vendorId])
}

model VendorProfileAuditLog {
  id              String                      @id @default(cuid())
  vendorId        String
  section         String
  fieldName       String
  oldValue        Json?
  newValue        Json?
  changedByUserId String?
  changedByEmail  String?
  changedAt       DateTime                    @default(now())
  reason          String?
  snapshotImpact  VendorProfileSnapshotImpact
  source          String
  vendor          Vendor                      @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([vendorId, changedAt])
  @@index([vendorId, section])
  @@index([fieldName])
}

model UserVendorAccess {
  id        String   @id @default(cuid())
  userId    String
  vendorId  String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  vendor    Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@unique([userId, vendorId])
}

model VendorIntegrationClient {
  id               String                           @id @default(cuid())
  vendorIdentifier String
  providerName     String
  tokenHash        String                           @unique
  enabled          Boolean                          @default(true)
  scopes           String[]
  lastUsedAt       DateTime?
  revokedAt        DateTime?
  createdAt        DateTime                         @default(now())
  updatedAt        DateTime                         @updatedAt
  auditLogs        VendorIntegrationAuditLog[]
  statusEvents     VendorIntegrationStatusEvent[]
  shipmentEvents   VendorIntegrationShipmentEvent[]
  invoiceEvents    VendorIntegrationInvoiceEvent[]

  @@index([vendorIdentifier])
  @@index([enabled, revokedAt])
}

model VendorIntegrationAuditLog {
  id               String                  @id @default(cuid())
  clientId         String
  vendorIdentifier String
  method           String
  path             String
  statusCode       Int
  requestId        String?
  createdAt        DateTime                @default(now())
  client           VendorIntegrationClient @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId, createdAt])
  @@index([vendorIdentifier, createdAt])
}

model ShopifyOrder {
  id                          String                       @id @default(cuid())
  sourceShopifyOrderId        String                       @unique
  sourceShopifyOrderNumber    String
  shopifyCreatedAt            DateTime?
  currency                    String?
  financialStatus             String?
  paymentGatewayName          String?
  taxesIncluded               Boolean?
  orderTaxAmount              Decimal?                     @db.Decimal(10, 2)
  shippingAmount              Decimal?                     @db.Decimal(10, 2)
  discountAmount              Decimal?                     @db.Decimal(10, 2)
  orderNote                   String?
  orderTags                   String[]                     @default([])
  customerName                String?
  customerEmail               String?
  customerPhone               String?
  billingFullName             String?
  billingCompany              String?
  billingPhone                String?
  billingCity                 String?
  billingDistrict             String?
  billingAddress1             String?
  billingAddress2             String?
  billingPostcode             String?
  shippingCountry             String?
  shippingPostcode            String?
  shippingCity                String?
  shippingDistrict            String?
  shippingAddress             String?
  totalPrice                  Decimal?                     @db.Decimal(10, 2)
  createdAt                   DateTime                     @default(now())
  updatedAt                   DateTime                     @updatedAt
  lineItems                   ShopifyOrderLineItem[]
  allocations                 VendorAllocation[]
  webhookEvents               WebhookEvent[]
  refunds                     ShopifyRefund[]
  financeEvents               FinanceEvent[]
  settlementRefundAdjustments SettlementRefundAdjustment[]
}

model ShopifyOrderLineItem {
  id                   String                     @id @default(cuid())
  shopifyOrderId       String
  sourceLineItemId     String
  shopifyProductId     String?
  sourceVariantId      String?
  sku                  String?
  title                String?
  imageUrl             String?
  quantity             Int                        @default(1)
  unitPrice            Decimal?                   @db.Decimal(10, 2)
  unitPriceVatIncluded Decimal?                   @db.Decimal(10, 2)
  lineTotalVatIncluded Decimal?                   @db.Decimal(10, 2)
  lineTaxAmount        Decimal?                   @db.Decimal(10, 2)
  vatRate              Decimal?                   @db.Decimal(5, 2)
  originalVendorId     String?
  createdAt            DateTime                   @default(now())
  updatedAt            DateTime                   @updatedAt
  order                ShopifyOrder               @relation(fields: [shopifyOrderId], references: [id], onDelete: Cascade)
  allocationLineItems  VendorAllocationLineItem[]
  refundLineItems      ShopifyRefundLineItem[]

  @@unique([shopifyOrderId, sourceLineItemId])
}

model VendorAllocation {
  id                                     String                           @id @default(cuid())
  sourceShopifyOrderId                   String
  sourceShopifyOrderNumber               String
  originalVendorId                       String
  assignedVendorId                       String
  allocationStatus                       AllocationStatus                 @default(ACTIVE)
  cancellationReason                     CancellationReason?
  reassignmentRequired                   Boolean                          @default(false)
  cancelRefundReviewStatus               String?
  cancelRefundReviewReason               String?
  cancelRefundReviewNote                 String?
  cancelRefundReviewRequestedAt          DateTime?
  cancelRefundReviewRequestedByUserId    String?
  fulfillmentStatus                      String                           @default("Pending")
  shippingStatus                         String                           @default("Awaiting Shipment")
  trackingNumber                         String?
  carrier                                String?
  vendorIntegrationTrackingUrl           String?
  vendorIntegrationShippedAt             DateTime?
  odooSaleOrderId                        String?
  odooSaleOrderName                      String?
  odooSaleOrderSyncedAt                  DateTime?
  vendorIntegrationStatus                String?
  vendorIntegrationStatusMessage         String?
  vendorIntegrationStatusUpdatedAt       DateTime?
  vendorIntegrationProvider              String?
  lastVendorIntegrationRequestId         String?
  lastVendorIntegrationShipmentRequestId String?
  vendorInvoiceNumber                    String?
  vendorInvoiceDate                      DateTime?
  vendorInvoiceUrl                       String?
  vendorInvoiceAmount                    Decimal?                         @db.Decimal(10, 2)
  vendorInvoiceReceivedAt                DateTime?
  lastVendorIntegrationInvoiceRequestId  String?
  createdAt                              DateTime                         @default(now())
  updatedAt                              DateTime                         @updatedAt
  order                                  ShopifyOrder                     @relation(fields: [sourceShopifyOrderId], references: [id], onDelete: Cascade)
  originalVendor                         Vendor                           @relation("originalVendor", fields: [originalVendorId], references: [id])
  assignedVendor                         Vendor                           @relation("assignedVendor", fields: [assignedVendorId], references: [id])
  lineItems                              VendorAllocationLineItem[]
  assignmentHistory                      AllocationAssignmentHistory[]
  fulfillment                            Fulfillment?
  returnRecords                          ReturnRecord[]
  refundRecords                          RefundRecord[]
  financeEntries                         FinanceLedgerEntry[]
  operationalJobs                        OperationalJob[]
  shippingCosts                          ShipmentShippingCost[]
  shipmentExecutions                     ShipmentExecution[]
  economicTransfers                      AllocationEconomicTransfer[]
  financeIntegrityAlerts                 FinanceIntegrityAlert[]
  operationalSignals                     OperationalSignal[]
  automationActions                      AutomationAction[]
  vendorIntegrationStatusEvents          VendorIntegrationStatusEvent[]
  vendorIntegrationShipmentEvents        VendorIntegrationShipmentEvent[]
  vendorIntegrationInvoiceEvents         VendorIntegrationInvoiceEvent[]
  outboundShopifyRefundAttempts          OutboundShopifyRefundAttempt[]

  @@index([createdAt])
  @@index([odooSaleOrderId])
  @@index([vendorIntegrationStatus])
  @@index([cancelRefundReviewStatus])
}

model OutboundShopifyRefundAttempt {
  id                               String           @id @default(cuid())
  vendorAllocationId               String
  shopifyOrderId                   String
  status                           String
  restockType                      String
  refundShipping                   Boolean          @default(false)
  notifyCustomer                   Boolean          @default(false)
  note                             String?
  requestedByUserId                String?
  requestedAt                      DateTime         @default(now())
  refundLineItemsJson              Json?
  suggestedTransactionsJson        Json?
  fulfillmentOrderCancellationJson Json?
  blockersJson                     Json?
  warningsJson                     Json?
  previewHash                      String?
  previewedAt                      DateTime?
  shopifyRefundId                  String?
  shopifyUserErrorsJson            Json?
  mutationResponseJson             Json?
  submittedAt                      DateTime?
  resolvedAt                       DateTime?
  failedAt                         DateTime?
  failureReason                    String?
  createdAt                        DateTime         @default(now())
  updatedAt                        DateTime         @updatedAt
  vendorAllocation                 VendorAllocation @relation(fields: [vendorAllocationId], references: [id], onDelete: Cascade)
  requestedByUser                  User?            @relation("outboundShopifyRefundAttemptRequestedBy", fields: [requestedByUserId], references: [id], onDelete: SetNull)

  @@index([vendorAllocationId])
  @@index([shopifyOrderId])
  @@index([status])
  @@index([shopifyRefundId])
  @@index([previewHash])
}

model VendorIntegrationInvoiceEvent {
  id                 String                  @id @default(cuid())
  clientId           String
  vendorAllocationId String
  vendorIdentifier   String
  providerName       String?
  invoiceNumber      String
  invoiceDate        DateTime
  invoiceUrl         String?
  invoiceAmount      Decimal                 @db.Decimal(10, 2)
  idempotencyKey     String
  requestId          String?
  createdAt          DateTime                @default(now())
  client             VendorIntegrationClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  vendorAllocation   VendorAllocation        @relation(fields: [vendorAllocationId], references: [id], onDelete: Cascade)

  @@unique([clientId, vendorAllocationId, idempotencyKey])
  @@index([vendorAllocationId, createdAt])
  @@index([vendorIdentifier, createdAt])
}

model VendorIntegrationShipmentEvent {
  id                 String                  @id @default(cuid())
  clientId           String
  vendorAllocationId String
  vendorIdentifier   String
  providerName       String?
  carrier            String
  trackingNumber     String
  trackingUrl        String?
  shippedAt          DateTime?
  idempotencyKey     String
  requestId          String?
  createdAt          DateTime                @default(now())
  client             VendorIntegrationClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  vendorAllocation   VendorAllocation        @relation(fields: [vendorAllocationId], references: [id], onDelete: Cascade)

  @@unique([clientId, vendorAllocationId, idempotencyKey])
  @@index([vendorAllocationId, createdAt])
  @@index([vendorIdentifier, createdAt])
}

model VendorIntegrationStatusEvent {
  id                 String                  @id @default(cuid())
  clientId           String
  vendorAllocationId String
  vendorIdentifier   String
  providerName       String?
  status             String
  message            String?
  idempotencyKey     String
  requestId          String?
  createdAt          DateTime                @default(now())
  client             VendorIntegrationClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  vendorAllocation   VendorAllocation        @relation(fields: [vendorAllocationId], references: [id], onDelete: Cascade)

  @@unique([clientId, vendorAllocationId, idempotencyKey])
  @@index([vendorAllocationId, createdAt])
  @@index([vendorIdentifier, createdAt])
}

model VendorAllocationLineItem {
  id                   String               @id @default(cuid())
  vendorAllocationId   String
  shopifyLineItemId    String
  quantity             Int                  @default(1)
  lineAmount           Decimal?             @db.Decimal(10, 2)
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  vendorAllocation     VendorAllocation     @relation(fields: [vendorAllocationId], references: [id], onDelete: Cascade)
  shopifyOrderLineItem ShopifyOrderLineItem @relation(fields: [shopifyLineItemId], references: [id], onDelete: Cascade)

  @@unique([vendorAllocationId, shopifyLineItemId])
}

model AllocationAssignmentHistory {
  id                 String           @id @default(cuid())
  vendorAllocationId String
  action             String
  fromVendorId       String?
  toVendorId         String
  reason             String?
  actorUserId        String?
  createdAt          DateTime         @default(now())
  vendorAllocation   VendorAllocation @relation(fields: [vendorAllocationId], references: [id], onDelete: Cascade)
  fromVendor         Vendor?          @relation("assignmentFromVendor", fields: [fromVendorId], references: [id])
  toVendor           Vendor           @relation("assignmentToVendor", fields: [toVendorId], references: [id])
  actorUser          User?            @relation("assignmentActor", fields: [actorUserId], references: [id])
}

model AllocationEconomicTransfer {
  id                       String                  @id
  vendorAllocationId       String
  fromVendorId             String
  toVendorId               String
  fromFinanceLedgerEntryId String?
  toFinanceLedgerEntryId   String?
  status                   String
  reason                   String?
  adminActorUserId         String?
  pricingSnapshotJson      Json?
  idempotencyKey           String                  @unique
  createdAt                DateTime                @default(now())
  completedAt              DateTime?
  failedAt                 DateTime?
  failureReason            String?
  vendorAllocation         VendorAllocation        @relation(fields: [vendorAllocationId], references: [id], onDelete: Cascade)
  fromVendor               Vendor                  @relation("economicTransferFromVendor", fields: [fromVendorId], references: [id])
  toVendor                 Vendor                  @relation("economicTransferToVendor", fields: [toVendorId], references: [id])
  fromFinanceLedgerEntry   FinanceLedgerEntry?     @relation("economicTransferFromLedger", fields: [fromFinanceLedgerEntryId], references: [id], onDelete: SetNull)
  toFinanceLedgerEntry     FinanceLedgerEntry?     @relation("economicTransferToLedger", fields: [toFinanceLedgerEntryId], references: [id], onDelete: SetNull)
  adminActorUser           User?                   @relation("economicTransferAdminActor", fields: [adminActorUserId], references: [id], onDelete: SetNull)
  financeIntegrityAlerts   FinanceIntegrityAlert[]

  @@index([vendorAllocationId])
  @@index([fromVendorId])
  @@index([toVendorId])
  @@index([status])
  @@index([createdAt])
}

model FinanceIntegrityAlert {
