PORT=4000
NODE_ENV=development
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vendor_dashboard_dev
CORS_ORIGIN=http://127.0.0.1:5173,http://localhost:5173
JWT_SECRET=dev-only-jwt-secret-change-in-production
JWT_EXPIRES_IN=12h
SHOPIFY_WEBHOOK_SECRET=dev-shopify-webhook-secret
SHOPIFY_RETURN_WEBHOOK_SECRET=
SHOPIFY_FULFILLMENT_WEBHOOK_SECRET=
SHOPIFY_SHOP_DOMAIN=
SHOPIFY_ADMIN_ACCESS_TOKEN=
SHOPIFY_API_VERSION=2024-01
SHOPIFY_READINESS_LIVE_CHECK=false
SHOPIFY_MOCK_SELLER_INFO=
SHOPIFY_MOCK_RETURN_DETAILS=
SHOPIFY_MOCK_ORDER_FULFILLMENT_STATE=
SHOPIFY_SELLER_INFO_RETRY_DELAY_MS=2000
SHOPIFY_MOCK_FULFILLMENT_ORDERS=
SHOPIFY_MOCK_FULFILLMENT_FAIL_ALLOCATION_IDS=
SHOPIFY_REGISTER_ORDER_WEBHOOKS=false
SHOPIFY_ORDER_WEBHOOK_BASE_URL=
SHOPIFY_REGISTER_FULFILLMENT_WEBHOOKS=false
SHOPIFY_FULFILLMENT_WEBHOOK_BASE_URL=
SHOPIFY_REGISTER_RETURN_WEBHOOKS=false
SHOPIFY_RETURN_WEBHOOK_BASE_URL=
EMAIL_NOTIFICATIONS_ENABLED=false
EMAIL_PROVIDER=noop
EMAIL_FROM=
EMAIL_ADMIN_RECIPIENTS=
INVOICE_EXECUTION_ENABLED=false
INVOICE_PROVIDER=bizimhesap
BIZIMHESAP_ENABLED=false
BIZIMHESAP_FIRM_ID=
BIZIMHESAP_API_KEY=
BIZIMHESAP_BASE_URL=
BIZIMHESAP_ADD_INVOICE_URL=
BIZIMHESAP_ACCESS_TOKEN=
# Live carrier calls require both the global gate and the provider gate.
SHIPPING_EXECUTION_ENABLED=false
SHIPPING_PROVIDER=kargo_entegrator
KARGO_ENTEGRATOR_ENABLED=false
KARGO_ENTEGRATOR_BASE_URL=
KARGO_ENTEGRATOR_API_KEY=
KARGO_ENTEGRATOR_CARGO_INTEGRATION_ID=
TRY_OTO_ENABLED=false
TRY_OTO_BASE_URL=https://staging-api.tryoto.com
TRY_OTO_REFRESH_TOKEN=
TRY_OTO_SANDBOX_MODE=true

# Optional safe build metadata for /health and /version.
GIT_COMMIT=
COMMIT_SHA=
