PORT=4000
NODE_ENV=development
SENTRY_DSN=
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vendor_dashboard_dev
CORS_ORIGIN=http://127.0.0.1:5173,http://localhost:5173
JWT_SECRET=dev-only-jwt-secret-change-in-production
JWT_EXPIRES_IN=12h
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=10
LOGIN_RATE_LIMIT_WINDOW_SECONDS=600
AUTH_RATE_LIMIT_RESET_ENABLED=false
AUTH_RATE_LIMIT_RESET_TOKEN=
# Shopify app Client Secret used for webhook HMAC verification; never use an Admin API access token.
SHOPIFY_WEBHOOK_SECRET=dev-shopify-webhook-secret
# Customer Account app identity used only for session-token JWT verification.
SHOPIFY_CUSTOMER_ACCOUNT_CLIENT_ID=
SHOPIFY_CUSTOMER_ACCOUNT_CLIENT_SECRET=
SHOPIFY_RETURN_WEBHOOK_SECRET=
SHOPIFY_FULFILLMENT_WEBHOOK_SECRET=
SHOPIFY_SHOP_DOMAIN=
# Shopify Admin API access token; never use the app Client Secret.
SHOPIFY_ADMIN_ACCESS_TOKEN=
SHOPIFY_API_VERSION=2024-01
SHOPIFY_ORDER_BACKFILL_CONFIRM=
SHOPIFY_ORDER_BACKFILL_NAME=
SHOPIFY_ORDER_BACKFILL_BACKEND_URL=
SHOPIFY_READINESS_LIVE_CHECK=false
SHOPIFY_MOCK_SELLER_INFO=
SHOPIFY_MOCK_RETURN_DETAILS=
SHOPIFY_MOCK_ORDER_FULFILLMENT_STATE=
SHOPIFY_SELLER_INFO_RETRY_DELAY_MS=2000
SHOPIFY_ORDERS_CREATE_EXECUTOR_ENABLED=false
SHOPIFY_ORDERS_CREATE_ASYNC_ACK_ENABLED=false
CUSTOMER_CANCELLATION_INTAKE_ENABLED=false
CUSTOMER_CANCELLATION_AUTO_REFUND_ENABLED=false
FULL_REFUND_CURRENT_STATE_REPAIR_WRITE_ENABLED=false
SHOPIFY_ORDERS_CREATE_EXECUTOR_INTERVAL_MS=2000
SHOPIFY_ORDERS_CREATE_EXECUTOR_BATCH_SIZE=5
SHOPIFY_ORDERS_CREATE_LEASE_MS=60000
SHOPIFY_ORDERS_CREATE_HEARTBEAT_MS=10000
SHOPIFY_MISSED_ORDER_DISCOVERY_ENABLED=false
SHOPIFY_MISSED_ORDER_DISCOVERY_INTERVAL_MS=900000
SHOPIFY_MISSED_ORDER_DISCOVERY_LOOKBACK_DAYS=7
SHOPIFY_MISSED_ORDER_DISCOVERY_GRACE_PERIOD_MS=900000
SHOPIFY_MISSED_ORDER_DISCOVERY_MAX_ORDERS=1000
SHOPIFY_MOCK_FULFILLMENT_ORDERS=
SHOPIFY_MOCK_FULFILLMENT_FAIL_ALLOCATION_IDS=
PRODUCT_PANEL_BASE_URL=
PRODUCT_PANEL_VARIANT_DISABLE_ENABLED=false
PRODUCT_PANEL_VARIANT_DISABLE_DRY_RUN=true
PRODUCT_PANEL_HMAC_SECRET=
CANONICAL_RECONCILIATION_ENABLED=true
CANONICAL_RECONCILIATION_MODE=dry-run
CANONICAL_RECONCILIATION_SCHEDULE_HOUR=3
CANONICAL_RECONCILIATION_LOOKBACK_DAYS=3
CANONICAL_RECONCILIATION_ORDER_LIMIT=500
SETTLEMENT_AUTO_DRAFT_JOB_ENABLED=false
SETTLEMENT_AUTO_DRAFT_JOB_DRY_RUN=true
SHOPIFY_REGISTER_ORDER_WEBHOOKS=false
SHOPIFY_ORDER_WEBHOOK_BASE_URL=
SHOPIFY_REGISTER_FULFILLMENT_WEBHOOKS=false
SHOPIFY_FULFILLMENT_WEBHOOK_BASE_URL=
SHOPIFY_REGISTER_RETURN_WEBHOOKS=false
SHOPIFY_RETURN_WEBHOOK_BASE_URL=
EMAIL_NOTIFICATIONS_ENABLED=false
EMAIL_PROVIDER=noop
EMAIL_FROM=
EMAIL_ADMIN_RECIPIENTS=
IYZICO_ENV=sandbox
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com
IYZICO_SANDBOX_API_KEY=
IYZICO_SANDBOX_SECRET_KEY=
IYZICO_SANDBOX_BASE_URL=https://sandbox-api.iyzipay.com
LOGO_ISBASI_BASE_URL=https://soho-isbasi-mwv2-test.logo-paas.com
LOGO_ISBASI_API_KEY=
# Base64-encoded 32-byte random key. Required only for Sopyo credential operations.
SOPYO_CREDENTIAL_ENCRYPTION_KEY=
SOPYO_DELIVERY_POLLING_ENABLED=false
SOPYO_ORDER_PUSH_WORKER_ENABLED=false
# Required only when SOPYO_ORDER_PUSH_WORKER_ENABLED=true; choose rollout values explicitly.
SOPYO_ORDER_PUSH_WORKER_INTERVAL_MS=
SOPYO_ORDER_PUSH_WORKER_BATCH_SIZE=
LOGO_ISBASI_USERNAME=
LOGO_ISBASI_PASSWORD=
ADMIN_PROBES_ENABLED=false
ADMIN_PROBE_TOKEN=
# Live carrier calls require both the global gate and the provider gate.
SHIPPING_EXECUTION_ENABLED=false
SHIPPING_PROVIDER=kargonomi
KARGONOMI_BASE_URL=https://app.kargonomi.com.tr/api/v1
KARGONOMI_API_TOKEN=
KARGONOMI_DEFAULT_WAREHOUSE_ID=
# Required for Kargonomi customer return shipments when customer TCKN/VKN is not collected.
KARGONOMI_ACCOUNT_TAX_NUMBER=

# Optional safe build metadata for /health and /version.
GIT_COMMIT=
COMMIT_SHA=
