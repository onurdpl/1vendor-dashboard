{
  "name": "vendor-dashboard-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prisma:generate": "prisma generate",
    "db:generate": "prisma generate",
    "db:deploy": "prisma migrate deploy",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:seed": "prisma db seed",
    "smoke": "node scripts/smoke.mjs",
    "shopify:readiness": "node scripts/shopify-readiness.mjs",
    "shopify:return-webhooks:register": "node scripts/shopify-register-return-webhooks.mjs",
    "shopify:fulfillment-webhooks:register": "node scripts/shopify-register-fulfillment-webhooks.mjs",
    "kargonomi:probe": "npm run build && node scripts/kargonomi-forward-probe.mjs"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.2.0",
    "@prisma/client": "^6.12.0",
    "fastify": "^5.6.1",
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.15.30",
    "prisma": "^6.12.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  }
}
